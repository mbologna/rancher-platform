{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>mbologna/.github//renovate-config.json"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins annotated with '# renovate:' in Ansible group_vars",
      "managerFilePatterns": [
        "/^ansible/group_vars/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?\\n[a-z0-9_]+: \"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Keep required_version a compatibility floor (OpenTofu releases lag Terraform's numbering)",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_version"
      ],
      "enabled": false
    },
    {
      "description": "RKE2 versions carry a +rke2rN build suffix",
      "matchDepNames": [
        "rancher/rke2"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+rke2r(?<build>\\d+)$"
    },
    {
      "description": "Stay on Helm 3 until kubernetes.core/helm-diff are validated against Helm 4",
      "matchDepNames": [
        "helm/helm"
      ],
      "allowedVersions": "<4"
    }
  ]
}
