---
profile: production
project_dir: ansible
exclude_paths:
  - .github/
  - terraform/
  # The Cluster API templates: Kubernetes manifests, not Ansible (yamllint covers them).
  - fleet/
  - renovate.json
  - ansible/collections/
mock_roles: []
# Lint the entry point as a playbook; otherwise a task list saved there passes.
kinds:
  - playbook: "**/ansible/main.yml"
