---
# Copy to hosts.yml (gitignored). SSH host-key options are set once in ansible.cfg.
servers:
  hosts:
    my-host:
      ansible_host: 1.2.3.4                  # IP or hostname of the target machine
      # rancher_hostname: rancher.example.com  # default: ansible_host if a DNS name, else rancher.<ip>.sslip.io
      ansible_user: root
      ansible_ssh_private_key_file: ~/.ssh/id_rsa
