---
# Copy to secrets.yml (gitignored) and set a real value:
#   cp group_vars/all/secrets.yml.example group_vars/all/secrets.yml
# Or encrypt it: ansible-vault encrypt group_vars/all/secrets.yml

# Rancher admin password (minimum 12 characters).
rancher_bootstrap_password: "CHANGE_ME"

# Optional: AWS keys for the CAPA provider. When set, the playbook stores them as the
# capa-credentials and cluster-identity Secrets that rancher-fleet-clusters expects, and enables
# the AWS provider. Encrypt this file if you set them.
# capa_aws_access_key_id: ""
# capa_aws_secret_access_key: ""
