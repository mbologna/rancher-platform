---
# Copy to secrets.yml (gitignored) and set a real value:
#   cp group_vars/all/secrets.yml.example group_vars/all/secrets.yml
# Or encrypt it: ansible-vault encrypt group_vars/all/secrets.yml

# Rancher admin password (minimum 12 characters).
rancher_bootstrap_password: "CHANGE_ME"

# Optional: the admin password, if you changed it in the Rancher UI. Deploy logs in with it to
# generate the kubeconfig; it falls back to rancher_bootstrap_password.
# rancher_admin_password: ""

# Optional: AWS keys for the CAPA provider. When set, the playbook stores them as the
# capa-credentials and cluster-identity Secrets that rancher-fleet-clusters expects, and enables
# the AWS provider. Encrypt this file if you set them.
# capa_aws_access_key_id: ""
# capa_aws_secret_access_key: ""

# Optional: a Docker Hub account for the registry cache (registry_cache_enabled in config.yml).
# Anonymous pulls are rate-limited per IP; an access token works as the password.
# registry_cache_dockerhub_username: ""
# registry_cache_dockerhub_password: ""

# Optional: S3 keys for etcd snapshot uploads (see rke2_etcd_s3_bucket in config.yml).
# rke2_etcd_s3_access_key: ""
# rke2_etcd_s3_secret_key: ""

# Optional: the Harbor admin password for helm_charts_harbor; defaults to rancher_bootstrap_password.
# harbor_admin_password: ""
