#!/usr/bin/env bash
# Managed by Ansible (rancher-platform)
set -euo pipefail
export KUBECONFIG="${KUBECONFIG:-{{ rke2_kubeconfig }}}"
PATH="{{ bin_dir }}:$PATH"

echo "=== Rancher: https://{{ rancher_hostname }} ==="
echo; echo "=== Nodes ==="
kubectl get nodes -o wide
for ns in cattle-system cert-manager cattle-turtles-system; do
  echo; echo "=== Pods in ${ns} ==="
  kubectl get pods -n "${ns}"
done
