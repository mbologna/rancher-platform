# Generated by Terraform. ansible/manage.sh uses this file when ansible/inventory/hosts.yml
# does not exist; otherwise pass it explicitly: ./manage.sh deploy -i ../terraform/generated/hosts.yml
servers:
  hosts:
    rancher-manager:
      ansible_host: ${public_ip}
      ansible_user: ${ansible_user}
      ansible_ssh_private_key_file: ${private_key_path}
      rancher_hostname: ${rancher_hostname}
