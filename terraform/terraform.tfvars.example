# Copy to terraform.tfvars (gitignored) and fill in your values.

aws_region   = "eu-west-1"
project_name = "rancher-platform"
environment  = "dev"

# EC2 (openSUSE Leap 16.0 by default; override ami_name_filter/ami_owner for another image)
instance_type       = "t3.xlarge"
root_volume_size_gb = 100

# SSH: public key uploaded as an EC2 key pair; private key defaults to the same path without .pub
public_key_path = "~/.ssh/id_rsa.pub"
# private_key_path = "~/.ssh/id_rsa"
ansible_user = "ec2-user"

# Rancher FQDN; defaults to rancher.<elastic-ip>.sslip.io
# rancher_hostname = "rancher.example.com"

# Network (or reuse a VPC with existing_vpc_id = "vpc-...")
vpc_cidr    = "10.0.0.0/16"
subnet_cidr = "10.0.1.0/24"

# ── Access control (required) ────────────────────────────────────────────────
# Find your public IP: curl -s https://checkip.amazonaws.com
# 80/443 (Rancher UI/API) are always open to all.

# SSH (22): your operator machine only; 0.0.0.0/0 is rejected
allowed_ssh_cidrs = ["YOUR_IP/32"]

# kubectl (6443): your operator machine only; 0.0.0.0/0 is rejected
allowed_admin_cidrs = ["YOUR_IP/32"]

# Downstream CAPI cluster nodes: 6443, 9345, 30000-32767, 8472/udp.
# Set to the VPC CIDR(s) where downstream clusters run, e.g. ["10.1.0.0/16", "10.2.0.0/16"].
allowed_cluster_cidrs = ["DOWNSTREAM_VPC_CIDR/16"]
