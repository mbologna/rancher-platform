# Ansible
*.retry
*.log
ansible_collections/
ansible/collections/

# Secrets — never commit credentials
ansible/group_vars/all/secrets.yml

# Python virtual environments
/venv/
/.venv/
/env/

# IDE and editor files
.idea/
.vscode/
*.swp
*~
*.bak
*.tmp

# macOS generated files
.DS_Store

# Inventory files with real hostnames — never commit these
ansible/inventory/hosts.yml
ansible/inventory/lima.yml

# Terraform
terraform/.terraform/
# Not committed: Terraform and OpenTofu record different registry addresses
terraform/.terraform.lock.hcl
terraform/terraform.tfvars
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/*.tfplan
terraform/crash.log
# Auto-generated inventory from Terraform (picked up by ansible/manage.sh)
terraform/generated/
# Optional remote state backend (copy of backend.tf.example) and workspace state
terraform/backend.tf
terraform/terraform.tfstate.d/
